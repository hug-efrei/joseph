# URL de l'instance BookOrbit (LAN interne recommandé : plus rapide, pas de
# dépendance à un nom public/TLS pour deux conteneurs sur le même hôte)
BOOKORBIT_URL="http://192.168.1.24:3000"
# Identifiants d'un utilisateur OPDS dédié (Réglages > OPDS dans BookOrbit),
# distinct du compte web principal.
BOOKORBIT_OPDS_USER="joseph"
BOOKORBIT_OPDS_PASSWORD="change-me"